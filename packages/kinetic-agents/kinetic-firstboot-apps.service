[Unit]
Description=Install ZypherOS Kinetic's standard apps (Cursor, Grok Bot, Flatseal, Gear Lever)
Documentation=https://github.com/zypher-systems/kinetic
Wants=network-online.target
After=network-online.target kinetic-snapshots-setup.service
# Installed systems only, once
ConditionKernelCommandLine=!rd.live.image
ConditionPathExists=!/var/lib/kinetic/firstboot-apps.done
StartLimitIntervalSec=0

[Service]
# Type=exec, not oneshot: the desktop must not wait for these downloads
Type=exec
ExecStart=/usr/libexec/kinetic/firstboot-apps
Restart=on-failure
RestartSec=10min
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
