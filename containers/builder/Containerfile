# Rootless helper image for checking the kiwi description and resolving its
# package list without building. ISO builds run on the host (build-iso.sh).
FROM registry.fedoraproject.org/fedora:44

RUN dnf -y install kiwi-cli distribution-gpg-keys python3 python3-solv libsolv-tools && \
    dnf clean all

WORKDIR /work
